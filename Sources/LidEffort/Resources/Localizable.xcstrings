    "Loaded models appear in Accounts → Connected and are checked every second. Embedding models are not shown." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已加载的模型会出现在「账号 → 已连接」，每秒检查一次。不显示嵌入模型。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modèles chargés apparaissent dans Comptes → Connectés et sont vérifiés chaque seconde. Les modèles d'embedding ne sont pas affichés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み込まれたモデルは アカウント → 接続済み に表示され、毎秒確認します。埋め込みモデルは表示しません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os modelos carregados aparecem em Contas → Conectado e são verificados a cada segundo. Modelos de embedding não aparecem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загруженные модели появляются в Аккаунты → Подключён и проверяются каждую секунду. Модели эмбеддингов не показываются."
          }
        }
      }
    },
