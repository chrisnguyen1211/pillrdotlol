    "Over a window it refracts; over the desktop it turns to a clear blur instead of a grey slab." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur une fenêtre, il réfracte ; sur le bureau, il devient un flou clair au lieu d'une plaque grise."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウの上では屈折し、デスクトップの上では灰色の板ではなく澄んだぼかしになります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobre uma janela, ele refrata; sobre a área de trabalho, vira um desfoque claro em vez de uma placa cinza."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Над окном оно преломляет свет; над рабочим столом становится прозрачным размытием, а не серой плитой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在窗口上方它会折射；在桌面上方它会变成清透的模糊，而不是一块灰板。"
          }
        }
      }
