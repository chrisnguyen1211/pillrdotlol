    "Agent sessions carry a success state, so a run that has completed reads differently from one still going." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントのセッションが成功状態を持つようになり、完了した実行と進行中の実行が区別して表示されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сеансы агентов содержат состояние успеха, поэтому завершённый запуск отличается от текущего."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "助手会话带有完成状态，已经跑完的和还在进行的看起来不一样。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sessions d'agent portent un état de réussite : une exécution terminée se distingue d'une exécution en cours."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As sessões de agente têm um estado de sucesso, então uma execução concluída aparece diferente de uma em andamento."
          }
        }
      }
    },
