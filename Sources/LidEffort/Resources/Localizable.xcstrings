        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ツールチップ、質問、完了カードを、ピルとは切り離して単独で。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dicas, perguntas e o cartão de conclusão, por conta própria, separados da cápsula."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подсказки, вопросы и карточка завершения отдельно от пилюли."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示卡、问题和完成卡片，独立于胶囊之外。"
          }
        }
      }
    },
    "Try it: pick an answer, then Send" : {
