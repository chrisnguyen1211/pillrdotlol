        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换…"
          }
        }
      }
    },
    "System Liquid Glass. Follows this Mac's Appearance settings, including Clear or Tinted glass and light or dark mode." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムの Liquid Glass。クリアか色付きか、ライトかダークかを含め、この Mac の「外観」設定に従います。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Системное жидкое стекло. Следует настройкам внешнего вида Mac, включая прозрачное или тонированное стекло и светлый или тёмный режим."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统液态玻璃。跟随这台 Mac 的外观设置，包括通透或着色玻璃，以及浅色或深色模式。"
          }
        }
      }
    },
    "Takes the least room on the edge. Readable, but not from across the desk." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prend le moins de place sur le bord. Lisible, mais pas de l'autre bout du bureau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "辺で占める場所が最小。読めますが、机の向こうからは無理です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocupa o mínimo de espaço na borda. Legível, mas não do outro lado da mesa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Занимает минимум места у края. Читается вблизи, но не издалека."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "边缘上占得最少。能读，但隔着桌子就不行。"
          }
        }
      }
    },
    "Team on demand" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
