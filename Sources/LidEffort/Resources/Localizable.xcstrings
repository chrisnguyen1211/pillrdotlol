        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の保存済みログインを macOS に再度要求します。「常に許可」を選べば以後は尋ねられません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pede novamente ao macOS o login salvo do %@. Escolha Sempre Permitir e ele deixará de perguntar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторно запрашивает у macOS сохранённый вход %@. Выберите «Разрешать всегда», чтобы больше не видеть этот запрос."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
