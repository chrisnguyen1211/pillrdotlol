    "Asks macOS for %@'s saved login again. Always Allow means it is asked less often." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redemande à macOS les identifiants enregistrés de %@. Avec Toujours autoriser, la demande revient moins souvent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の保存済みログインを macOS に再度要求します。「常に許可」を選ぶと、確認の回数が減ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pede novamente ao macOS o login salvo do %@. Com Sempre Permitir, ele pergunta com menos frequência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторно запрашивает у macOS сохранённый вход %@. С «Разрешать всегда» запросов будет меньше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再次向 macOS 请求 %@ 已保存的登录信息。选「始终允许」可以少问几次。"
          }
        }
      }
    },
