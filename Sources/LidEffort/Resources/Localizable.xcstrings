    "%@ has no effort level, so the lid leaves it alone" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a pas de niveau d’effort : le couvercle n’y touche pas"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ には effort レベルがないため、蓋では変更しません"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não tem nível de esforço, então a tampa não mexe nele"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У %@ нет уровня усилия, поэтому крышка его не трогает"
          }
