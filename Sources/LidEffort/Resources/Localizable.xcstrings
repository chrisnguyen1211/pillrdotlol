    "No agent reports a plan yet. Claude and Codex logins count here when set to Monthly plan in Settings → Costs." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun agent n'indique encore de forfait. Les connexions Claude et Codex comptent ici quand elles sont réglées sur Forfait mensuel dans Réglages → Coûts."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだプランを報告しているエージェントはありません。Claude と Codex のログインは、設定 → コスト で月額プランにするとここに数えられます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum agente informa um plano ainda. Logins do Claude e do Codex entram aqui quando definidos como Plano mensal em Ajustes → Custos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока ни один агент не сообщает тариф. Входы Claude и Codex учитываются здесь, если в Настройки → Расходы выбран месячный тариф."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
