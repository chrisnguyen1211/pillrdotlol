    "Turns are read from the transcripts each account writes; the first ones show up a few minutes after a session starts." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tours sont lus dans les transcriptions écrites par chaque compte ; les premiers apparaissent quelques minutes après le début d'une session."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターンは各アカウントが書き出すトランスクリプトから読み取ります。最初のターンはセッション開始の数分後に表示されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os turnos são lidos das transcrições que cada conta grava; os primeiros aparecem alguns minutos depois do início da sessão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ходы читаются из журналов, которые пишет каждый аккаунт; первые появляются через несколько минут после начала сеанса."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回合从每个账号写下的记录里读取；会话开始几分钟后，头几条就会出现。"
          }
        }
      }
    },
