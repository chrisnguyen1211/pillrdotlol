    "See the whole question, what each choice means and the full command, then answer without leaving what you were doing." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyez la question entière, le sens de chaque choix et la commande complète, puis répondez sans quitter ce que vous faisiez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "質問の全文、各選択肢の意味、コマンド全体を確認してから、作業の手を止めずに答えられます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja a pergunta inteira, o que cada opção significa e o comando completo, e responda sem sair do que estava fazendo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотрите весь вопрос, значение каждого варианта и полную команду — и отвечайте, не отрываясь от дел."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看到完整的问题、每个选项的含义和完整命令，然后不用放下手头的事就能回答。"
          }
        }
      }
    },
