        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наведите на простаивающую сессию и ответьте. pillr вводит текст, только когда агент ждёт, и никогда поверх черновика."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
