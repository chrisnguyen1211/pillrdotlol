{
  "sourceLanguage" : "en",
  "strings" : {
    "\"12% used · 88% left\", so a reading lines up with whichever end your vendor happens to show." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« 12 % utilisés · 88 % restants », pour qu'un relevé corresponde au bout que votre fournisseur affiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「12% 使用 · 残り 88%」。ベンダーがどちらの数値を示していても、読み取りが噛み合います。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"12% usado · 88% restante\", para que uma leitura combine com o lado que o seu fornecedor exibir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Использовано 12% · осталось 88%», поэтому показание совпадает с тем, какую сторону показывает поставщик."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「12% 已用 · 88% 剩余」，读数能对上供应商碰巧展示的那一端。"
          }
        }
      }
    },
