    },
    "Each read from the tool already signed in on this Mac. spyx never asks for a password." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chacun lu depuis l'outil déjà connecté sur ce Mac. spyx ne demande jamais de mot de passe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
