          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada um lido da ferramenta já conectada neste Mac. O spyx nunca pede uma senha."
          }
        },
        "ru" : {
          "stringUnit" : {
