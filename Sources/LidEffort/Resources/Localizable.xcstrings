    "Your agents' limits, status and effort — on a notch, and a lid." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les limites, l'état et l'effort de vos agents — sur une encoche, et un capot."
          }
        },
        "ja" : {
