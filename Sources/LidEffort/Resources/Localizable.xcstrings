        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已在刘海中隐藏 · %1$@"
          }
        }
      }
    },
    "%@, shown together in one cell" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, affichées ensemble dans une seule cellule"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@、1 つのセルにまとめて表示"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, mostradas juntas em uma célula"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, показаны вместе в одной ячейке"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@，一起显示在一个单元格中"
