            "value" : "设置里一个图标搞定，或让 pillr 跟随你的 Mac。"
          }
        }
      }
    },
    "Optional (read from the key)" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif (lu depuis la clé)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意（キーから読み取ります）"
