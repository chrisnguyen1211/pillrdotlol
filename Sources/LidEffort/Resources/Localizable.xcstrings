    "Only needed when no coding tool on this Mac holds the key. Checked with Z.ai before it is kept; stored in your login keychain." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessaire seulement si aucun outil de code de ce Mac ne détient la clé. Vérifiée auprès de Z.ai avant d’être gardée ; stockée dans votre trousseau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac のコーディングツールがキーを持っていない場合だけ必要です。保存前に Z.ai で確認し、ログインキーチェーンに保管します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só é necessária se nenhuma ferramenta deste Mac tiver a chave. Verificada com a Z.ai antes de ser guardada; armazenada nas suas Chaves."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужен, только если ни один инструмент на этом Mac не хранит ключ. Проверяется в Z.ai перед сохранением; хранится в связке ключей."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当此 Mac 上没有编程工具保存该密钥时才需要。保存前会先向 Z.ai 验证，并存入登录钥匙串。"
          }
        }
      }
