          }
        }
      }
    },
    "Z.ai's Coding Plan reads live now too, with a key borrowed from whichever tool already holds one." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Coding Plan de Z.ai se lit aussi en direct désormais, avec une clé empruntée à l'outil qui en détient déjà une."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z.ai の Coding Plan もライブで読み取れるようになりました。キーは、すでにそれを持っているツールから借ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Coding Plan da Z.ai também é lido ao vivo agora, com uma chave emprestada de qualquer ferramenta que já tenha uma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тариф Z.ai Coding Plan теперь тоже читается в реальном времени с ключом из уже авторизованного инструмента."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z.ai 的 Coding Plan 现在也实时读取，密钥借自已经持有它的那个工具。"
          }
        }
      }
    },
    "and %lld more" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
