    "macOS refused spyx access to %@'s saved login. Use Allow access… in Settings to ask again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS a refusé à spyx l'accès aux identifiants enregistrés de %@. Utilisez Autoriser l'accès… dans les Réglages pour redemander."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS は spyx による %@ の保存済みログインへのアクセスを拒否しました。再度要求するには、設定の「アクセスを許可…」を使ってください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS negou ao spyx acesso ao login salvo do %@. Use Permitir acesso… nos Ajustes para pedir de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS отказала spyx в доступе к сохранённому входу %@. Нажмите «Разрешить доступ…» в настройках, чтобы запросить снова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 拒绝 spyx 访问 %@ 已保存的登录信息。在设置里用「允许访问…」再请求一次。"
          }
        }
      }
    },
    "spyx can be anywhere!" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
