    "That display is disconnected. pillr follows the active window until it returns." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet écran est déconnecté. pillr suit la fenêtre active jusqu'à son retour."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのディスプレイは接続されていません。復帰するまで、pillr はアクティブなウインドウに追従します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
