    "Also in Notification Center — for when the notch is hidden or on another display." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aussi dans le Centre de notifications — pour quand l'encoche est masquée ou sur un autre écran."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知センターにも — ノッチが隠れているときや、別のディスプレイにあるときのために。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também na Central de Notificações — para quando o notch estiver oculto ou em outra tela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Также в Центре уведомлений — на случай, если панель скрыта или находится на другом дисплее."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也会出现在通知中心 — 以防刘海被隐藏或在另一台显示器上。"
          }
        }
      }
    },
    "Also supported when installed: %@. Any other app still comes to the front when you click its session." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Également pris en charge une fois installés : %@. Toute autre app passe quand même au premier plan quand vous cliquez sur sa session."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストールされていれば %@ にも対応します。その他のアプリも、セッションをクリックすれば前面に出ます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também compatíveis quando instalados: %@. Qualquer outro app ainda vem para a frente quando você clica na sessão dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Также поддерживаются, если установлены: %@. Любое другое приложение тоже выходит на передний план при щелчке по его сеансу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装后也支持：%@。点击其他应用的会话，该应用仍会被带到前台。"
          }
        }
      }
    },
