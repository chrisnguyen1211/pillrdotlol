        }
      }
    },
    "Nothing is connected, so the notch has no rings to draw." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n'est connecté : l'encoche n'a donc aucun anneau à dessiner."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何も接続されていないため、ノッチに描くリングがありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada está conectado, então o notch não tem anéis para desenhar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничего не подключено, поэтому панели нечего отображать."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有已连接的服务，刘海里没有圆环可画。"
          }
        }
      }
    },
    "Nothing on screen. Open spyx again from Applications to bring these settings back." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien à l'écran. Rouvrez spyx depuis Applications pour retrouver ces réglages."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面には何も出ません。この設定に戻るには、アプリケーションから spyx をもう一度開いてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada na tela. Abra o spyx novamente em Aplicativos para trazer estes ajustes de volta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничего не показывать. Откройте spyx снова из Программ, чтобы вернуть эти настройки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屏幕上什么都没有。从「应用程序」再打开 spyx，才能回到这些设置。"
          }
        }
      }
    },
    "Nothing on screen. The readings stay in the menu bar menu when App icon is Menu bar. Otherwise, open spyx again from Applications to bring these settings back." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien à l'écran. Les relevés restent dans le menu de la barre des menus quand Icône de l'app est réglée sur Barre des menus. Sinon, rouvrez spyx depuis Applications pour retrouver ces réglages."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面には何も出ません。「アプリアイコン」が「メニューバー」なら、読み取りはメニューバーのメニューに残ります。それ以外の場合、この設定に戻るには、アプリケーションから spyx をもう一度開いてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada na tela. As leituras continuam no menu da barra de menus quando o Ícone do app é Barra de menus. Caso contrário, abra o spyx novamente em Aplicativos para trazer estes ajustes de volta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На экране ничего нет. Если значок приложения находится в строке меню, показания остаются в её меню. Иначе снова откройте spyx из папки «Программы», чтобы вернуть эти настройки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屏幕上什么都没有。应用图标选「菜单栏」时，读数仍在菜单栏菜单里。否则，从「应用程序」再打开 spyx，才能回到这些设置。"
          }
        }
      }
    },
    "Notifications" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notificações"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомления"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知"
          }
        }
      }
    },
    "Nudge it clear of another menu-bar app anchored to the same spot; remembered per edge." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décalez-la pour dégager une autre app de la barre des menus ancrée au même endroit ; mémorisé pour chaque bord."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ位置に固定された別のメニューバーアプリを避けてずらせます。位置は辺ごとに記憶されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afaste-a de outro app da barra de menus fixado no mesmo ponto; lembrado por borda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сдвиньте её, чтобы освободить место для другого приложения в строке меню; положение запоминается для каждого края."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把它挪开，避开钉在同一位置的其他菜单栏应用；按边缘记住。"
          }
        }
      }
    },
    "Off" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフ"
          }
        },
        "ru" : {
