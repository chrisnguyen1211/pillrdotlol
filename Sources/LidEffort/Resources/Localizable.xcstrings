        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "就这么多：点一下，你就回到了手头的事。"
          }
        }
      }
    },
    "The answer goes straight back to that session, and Claude keeps going." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
