    "pillr is now signed with a Developer ID and notarized by Apple, so macOS opens it without Open Anyway." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pillr est désormais signé avec un Developer ID et notarisé par Apple : macOS l'ouvre sans « Ouvrir quand même »."
          }
        },
        "ja" : {
          "stringUnit" : {
