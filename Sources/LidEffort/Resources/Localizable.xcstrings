    "Hover an idle session and answer it. pillr types it in only when the agent is waiting, never over a draft." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Survolez une session inactive et répondez. pillr ne la saisit que quand l’agent attend, jamais par-dessus un brouillon."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "待機中のセッションにカーソルを合わせて返信。pillr はエージェントが待っているときだけ入力し、下書きには上書きしません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe o mouse por uma sessão parada e responda. O pillr só digita quando o agente está esperando, nunca sobre um rascunho."
          }
