    "You stay signed in to %@ — end that session in %@ itself." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous restez connecté à %@ — terminez cette session dans %@ même."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ にはサインインしたままです — そのセッションを終えるには %@ 側で操作してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você continua conectado no %@ — encerre essa sessão no próprio %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы останетесь вошли в %@ — завершите сессию непосредственно в %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在 %@ 里仍然是登录状态 — 要结束会话，去 %@ 里操作。"
          }
        }
      }
    },
    "You stay signed in to the tool that owns the account." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous restez connecté à l'outil qui détient le compte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのアカウントを持つツールにはサインインしたままです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você continua conectado na ferramenta dona da conta."
          }
        },
        "ru" : {
