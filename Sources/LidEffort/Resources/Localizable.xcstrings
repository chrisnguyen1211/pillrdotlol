    "That's the whole of it: one click, and you're back to what you were doing." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est tout : un clic, et vous revoilà à ce que vous faisiez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これで全部です。ワンクリックで、元の作業に戻れます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É só isso: um clique, e você volta ao que estava fazendo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вот и всё: один щелчок — и вы вернулись к своим делам."
