        }
      }
    },
    "Run kiro-cli login in Terminal. The notch asks kiro-cli /usage for your credits." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exécutez kiro-cli login dans le Terminal. L’encoche demande vos crédits à kiro-cli /usage."
          }
