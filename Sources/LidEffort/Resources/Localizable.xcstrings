        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有 effort 级别，合盖手势不会改动它"
          }
        }
      }
    },
    "%@ is typed into the session in view at the lid's top. The config can't hold it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est saisi dans la session affichée tout en haut du couvercle. La config ne peut pas le garder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は蓋の最上段で表示中のセッションに入力されます。設定ファイルには保存できません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é digitado na sessão em vista no topo da tampa. A config não consegue guardá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ вводится в открытую сессию в верхнем положении крышки. Конфиг не может его хранить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在合盖手势的最高档，%@ 会输入到当前会话。配置文件无法保存它。"
          }
        }
      }
    },
    "%@ isn't in %@'s current model list. If it stops working, pick another in %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ n’est pas dans la liste actuelle de modèles de %2$@. S’il cesse de marcher, choisissez-en un autre dans %3$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は %2$@ の現在のモデル一覧にありません。動かなくなったら %3$@ で別のモデルを選んでください"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ não está na lista atual de modelos do %2$@. Se parar de funcionar, escolha outro em %3$@"
