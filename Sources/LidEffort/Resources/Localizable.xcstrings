          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войдите и возвращайтесь: pillr следит за этим"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录后回来即可，pillr 正在等待"
          }
        }
      }
    },
    "Signs out of %@. The session belongs to pillr." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous déconnecte de %@. La session appartient à pillr."
