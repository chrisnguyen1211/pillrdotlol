        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Execute grok login. Ele faz o login e renova o token que isto lê."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запустите grok login. Команда выполнит вход и обновит читаемый токен."
