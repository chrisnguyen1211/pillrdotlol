          }
        }
      }
    },
    "Switch on the agents you use. spyx reads each one's usage with the login it already has on this Mac, and sends nothing anywhere but that agent's own servers." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez les agents que vous utilisez. spyx lit la consommation de chacun avec les identifiants déjà présents sur ce Mac, et n'envoie rien ailleurs qu'aux propres serveurs de cet agent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使っているエージェントをオンにしてください。spyx はこの Mac にある既存のログインでそれぞれの使用量を読み取り、そのエージェント自身のサーバー以外には何も送信しません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative os agentes que você usa. O spyx lê o uso de cada um com o login que ele já tem neste Mac, e não envia nada a lugar algum além dos próprios servidores desse agente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите агенты, которыми пользуетесь. spyx читает использование каждого через вход, который уже есть на этом Mac, и ничего не отправляет никуда, кроме серверов самого агента."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开你在用的智能体。spyx 用它们在这台 Mac 上已有的登录读取各自的用量，除了该智能体自己的服务器，不向任何地方发送数据。"
          }
        }
      }
    },
