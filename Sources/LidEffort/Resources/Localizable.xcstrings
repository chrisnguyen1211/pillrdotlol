    "What each project spent of each login's allowance, priced from your plan." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que chaque projet a dépensé du quota de chaque compte, valorisé selon votre forfait."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ログインの利用枠のうち、各プロジェクトが使った分を、プランの価格で表示します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto cada projeto gastou da cota de cada login, com preço do seu plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сколько каждый проект потратил из лимита каждого входа — в деньгах по вашему тарифу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各项目用掉了每个登录额度的多少，按你的套餐计价。"
          }
        }
      }
    },
    "Sign in to QianwenAI to read your Token Plan usage" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous à QianwenAI pour lire l'utilisation de votre Token Plan"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token Plan の使用量を読み取るには QianwenAI にサインインしてください"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre no QianwenAI para ler o uso do seu Token Plan"
          }
        },
        "ru" : {
          "stringUnit" : {
