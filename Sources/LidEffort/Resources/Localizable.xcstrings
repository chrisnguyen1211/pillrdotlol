        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ нет в текущем списке моделей %2$@. Если перестанет работать, выберите другую в %3$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
