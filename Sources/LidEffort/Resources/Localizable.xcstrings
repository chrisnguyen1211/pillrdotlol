    "Reading Claude Code's and Antigravity's keychain items without a prompt is now a choice in Settings → General → Sign-ins, off by default." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lire sans invite les éléments du trousseau de Claude Code et d'Antigravity est maintenant un choix dans Réglages → Général → Connexions, désactivé par défaut."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code と Antigravity のキーチェーン項目を確認なしで読むかどうかは、設定 → 一般 → サインイン で選べるようになりました。初期設定はオフです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ler sem aviso os itens das chaves do Claude Code e do Antigravity agora é uma opção em Ajustes → Geral → Logins, desativada por padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
