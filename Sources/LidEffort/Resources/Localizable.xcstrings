    },
    "Answer Claude Code's questions and approvals from the notch, and see how much of your plan is left." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répondez aux questions et autorisations de Claude Code depuis l'encoche, et voyez ce qu'il reste de votre plan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code の質問や承認にノッチから答え、プランの残りも確認できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responda às perguntas e aprovações do Claude Code pelo notch, e veja quanto resta do seu plano."
          }
        },
