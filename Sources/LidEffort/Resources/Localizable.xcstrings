        }
      }
    },
    "Create an API token under My Profile → API Tokens with Account Analytics: Read, then copy the Account ID from the right-hand side of the Cloudflare dashboard." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez un jeton d’API dans My Profile → API Tokens avec Account Analytics: Read, puis copiez l’Account ID affiché à droite du tableau de bord Cloudflare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My Profile → API Tokens で Account Analytics: Read 付きの API トークンを作成し、Cloudflare ダッシュボード右側の Account ID をコピーしてください。"
          }
        },
        "pt-BR" : {
