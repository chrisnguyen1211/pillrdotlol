        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナルで kiro-cli login を実行してください。ノッチは kiro-cli /usage にクレジットを問い合わせます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Execute kiro-cli login no Terminal. O notch consulta seus créditos com kiro-cli /usage."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполните kiro-cli login в Терминале. Вырез запрашивает кредиты через kiro-cli /usage."
