        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ からサインアウトします。このセッションは pillr のものです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sai do %@. A sessão pertence ao pillr."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выход из %@. Сессия принадлежит pillr."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会退出 %@，这个会话属于 pillr。"
          }
        }
      }
    },
    "Switched off. Nothing is read." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivée. Rien n'est lu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフです。何も読み取りません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desligada. Nada é lido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключён, ничего не читается."
          }
