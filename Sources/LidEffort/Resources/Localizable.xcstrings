            "value" : "⌘ を押しながら蓋を動かして推論レベルを設定"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure ⌘ e mova a tampa para definir o esforço"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте ⌘ и двигайте крышку, чтобы задать усилие"
          }
        },
