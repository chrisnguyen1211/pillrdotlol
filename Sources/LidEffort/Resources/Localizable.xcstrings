    "pillr copies itself there and reopens. Any older copy goes to the Trash." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pillr s'y copie et se rouvre. Toute ancienne copie part à la Corbeille."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pillr が自身をそこへコピーして開き直します。古いコピーはゴミ箱に移動します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O pillr se copia para lá e reabre. Qualquer cópia antiga vai para a Lixeira."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pillr скопирует себя туда и перезапустится. Старые копии отправятся в Корзину."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pillr 会把自己复制过去并重新打开。旧副本会移到废纸篓。"
          }
        }
      }
    },
    "pillr is running from %@. macOS forgets permissions given to a copy there, and won't open it at login." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pillr s'exécute depuis %@. macOS oublie les autorisations données à une copie à cet endroit, et ne l'ouvrira pas à l'ouverture de session."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pillr は %@ から実行されています。macOS はそこにあるコピーに与えた許可を忘れ、ログイン時にも開きません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O pillr está rodando a partir de %@. O macOS esquece as permissões dadas a uma cópia ali, e não a abre ao iniciar a sessão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pillr запущен из %@. macOS забывает разрешения, выданные копии в этом месте, и не будет открывать её при входе."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pillr 正从%@运行。macOS 会忘记授予那里副本的权限，也不会在登录时打开它。"
          }
        }
      }
    },
