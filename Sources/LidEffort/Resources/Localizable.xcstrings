    },
    "A personal key that isn't held to one workspace now reads costs too, and an individual account is told how to get there." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une clé personnelle non limitée à un espace de travail lit désormais aussi les coûts, et un compte individuel apprend comment y parvenir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 つのワークスペースに限定されていない個人キーでもコストを読めるようになり、個人アカウントにはその方法を案内します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma chave pessoal não limitada a um workspace agora também lê os custos, e uma conta individual fica sabendo como chegar lá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Личный ключ, не ограниченный одним рабочим пространством, теперь тоже читает расходы, а индивидуальному аккаунту подсказывается, как этого добиться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不限于单个工作区的个人密钥现在也能读取费用，个人账号也会得到操作指引。"
          }
        }
      }
    },
    "Every word translated" : {
