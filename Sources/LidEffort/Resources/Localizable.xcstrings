    "Add, rename or switch keys off under API." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez, renommez ou désactivez les clés dans API."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーの追加、名前の変更、オフは「API」で行います。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione, renomeie ou desligue chaves em API."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляйте, переименовывайте и отключайте ключи на вкладке API."
