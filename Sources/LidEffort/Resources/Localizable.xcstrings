          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta chave não foi aceita. Remova-a nos Ajustes e adicione uma que funcione"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот ключ не принят. Удалите его в настройках и добавьте рабочий"
