<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <!-- Hardened runtime blocks Apple Events without this: /effort into
       Terminal, and opening a session's tab in Terminal, iTerm2, cmux and Ghostty. -->
  <key>com.apple.security.automation.apple-events</key><true/>
  <!-- Hardened runtime blocks the microphone without this: hold fn in the
       reply field to speak a reply. -->
  <key>com.apple.security.device.audio-input</key><true/>
</dict></plist>
